              "helpUri": "https://github.com/JetBrains/resharper-unity/wiki/Order-of-multiplication-operations-is-inefficient",
              "relationships": [
                {
                  "target": {
                    "id": "CSHARP.UNITY_PERFORMANCE",
                    "toolComponent": {
                      "name": "InspectCode"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "Unity.InstantiateWithoutParent",
              "fullDescription": {
                "text": "Instantiating a Unity object and setting the 'parent' property as separate operations is inefficient, as the transform hierarchy is created and immediately replaced. Combine setting the 'parent' property with the call to instantiate the object."
              },
              "help": {
                "text": "https://github.com/JetBrains/resharper-unity/wiki/Avoid-using-Object.Instantiate-without-“Transform-Parent”-parameter-and-using-SetParent-later"
              },
              "shortDescription": {
                "text": "Setting 'parent' property immediately after object instantiation is inefficient"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/JetBrains/resharper-unity/wiki/Avoid-using-Object.Instantiate-without-“Transform-Parent”-parameter-and-using-SetParent-later",
              "relationships": [
                {
                  "target": {
                    "id": "CSHARP.UNITY",
                    "toolComponent": {
                      "name": "InspectCode"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "Unity.PreferAddressByIdToGraphicsParams",
              "fullDescription": {
                "text": "String based property lookup is inefficient, as each time the method is called, the string name is converted into an integer value. Prefer calculating the integer value once and caching the result."
              },
              "help": {
                "text": "https://github.com/JetBrains/resharper-unity/wiki/Avoid-using-string-based-names-for-setting-and-getting-properties-on-Animators,-Shaders-and-Materials"
              },
              "shortDescription": {
                "text": "String based graphics property lookup is inefficient"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/JetBrains/resharper-unity/wiki/Avoid-using-string-based-names-for-setting-and-getting-properties-on-Animators,-Shaders-and-Materials",
              "relationships": [
                {
                  "target": {
                    "id": "CSHARP.UNITY",
                    "toolComponent": {
                      "name": "InspectCode"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "Unity.PreferNonAllocApi",
              "fullDescription": {
                "text": "An alternative method is available that avoids allocation and reuses an existing buffer."
              },
              "help": {
                "text": "https://github.com/JetBrains/resharper-unity/wiki/Avoid-using-allocating-versions-of-Physics-Raycast-functions"
              },
              "shortDescription": {
                "text": "Alternative non-allocating method available"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/JetBrains/resharper-unity/wiki/Avoid-using-allocating-versions-of-Physics-Raycast-functions",
              "relationships": [
                {
                  "target": {
                    "id": "CSHARP.UNITY",
                    "toolComponent": {
                      "name": "InspectCode"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "Unity.RedundantAttributeOnTarget",
              "fullDescription": {
                "text": "The attribute does not define any restrictions on valid targets, but is only useful when applied to specific declarations, e.g. field, class or method."
              },
              "help": {
                "text": "https://github.com/JetBrains/resharper-unity/wiki/Attribute-is-redundant-when-applied-to-this-declaration-type"
              },
              "shortDescription": {
                "text": "Redundant attribute usage: Attribute is redundant when applied to this declaration type"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/JetBrains/resharper-unity/wiki/Attribute-is-redundant-when-applied-to-this-declaration-type",
