                  "target": {
                    "id": "CSHARP.UNITY",
                    "toolComponent": {
                      "name": "InspectCode"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "Unity.RedundantEventFunction",
              "fullDescription": {
                "text": "Empty Unity event functions are still called from native code, which affects performance."
              },
              "help": {
                "text": "https://github.com/JetBrains/resharper-unity/wiki/Redundant-Unity-event-function"
