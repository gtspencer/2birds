            {
              "id": "UseNameOfInsteadOfTypeOf",
              "fullDescription": {
                "text": "Replace 'typeof(T).Name' or 'GetType().Name' expression with constant 'nameof' expression"
              },
              "help": {
                "text": "https://www.jetbrains.com/help/resharper/UseNameOfInsteadOfTypeOf.html"
              },
              "shortDescription": {
                "text": "Use 'nameof' expression to reference type name"
              },
              "defaultConfiguration": {
