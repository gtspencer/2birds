{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .agentignore.hook.ps1",
            "commandWindows": "powershell -NoProfile -File .agentignore.hook.ps1",
            "timeout": 10,
            "statusMessage": "Checking .agentignore"
          }
        ]
      }
    ]
  }
}
