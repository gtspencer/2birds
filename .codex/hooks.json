{
  "description": "Block .agentignore paths and mutating Git operations.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/.agentignore.codex.hook.cmd",
            "commandWindows": ".hooks\\.agentignore.codex.hook.cmd",
            "timeout": 10,
            "statusMessage": "Checking .agentignore"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/block-git-writes.codex.hook.cmd",
            "commandWindows": ".hooks\\block-git-writes.codex.hook.cmd",
            "timeout": 10,
            "statusMessage": "Checking Git command"
          }
        ]
      }
    ]
  }
}