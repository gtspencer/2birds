{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"$(git rev-parse --show-toplevel)/.hooks/.agentignore.codex.hook.ps1\"",
            "commandWindows": "powershell -NoProfile -File \"$(git rev-parse --show-toplevel)/.hooks/.agentignore.codex.hook.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking .agentignore"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .hooks/block-git-writes.ps1",
            "commandWindows": "powershell -NoProfile -File .hooks/block-git-writes.ps1",
            "timeout": 10,
            "statusMessage": "Checking for git write operations"
          }
        ]
      }
    ]
  }
}
