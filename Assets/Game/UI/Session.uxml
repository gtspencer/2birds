<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Shared.uss" />
    <ui:Template name="Settings" src="Settings.uxml" />
    <ui:VisualElement class="overlay" picking-mode="Ignore">
        <ui:VisualElement name="session-panel" class="card pause" style="display: none;">
            <ui:VisualElement name="pause-page">
                <ui:Label text="Session" class="title" />
                <ui:Label name="status" class="status" />
                <ui:Button name="resume" text="Resume" />
                <ui:Button name="settings" text="Settings" />
                <ui:Button name="invite" text="Invite Steam Friends" />
                <ui:Button name="leave" text="Leave Session" />
            </ui:VisualElement>
            <ui:Instance template="Settings" class="shared-settings" />
            <ui:VisualElement name="session-footer" class="hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
