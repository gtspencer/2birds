.hud-root { flex-grow: 1; }

.interaction-tooltip {
    display: none;
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    background-color: rgba(20, 28, 36, 0.92);
    color: rgb(231, 237, 241);
    font-size: 16px;
}

.interaction-glyph {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin: 0 6px;
}

.interaction-keycap {
    min-width: 28px;
    min-height: 28px;
    margin: 0 6px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgb(179, 195, 205);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.interaction-action {
    flex-shrink: 1;
    white-space: normal;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}

.charge-track {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60px;
    height: 5px;
    margin-left: -30px;
    margin-top: 14px;
    border-radius: 2px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.6);
}

.charge-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(165, 225, 204);
}

.health-container {
    position: absolute;
    top: 20px;
    left: 20px;
    flex-direction: row;
    align-items: center;
}

.health-bar-bg {
    width: 200px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    overflow: hidden;
}

.health-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(76, 175, 80);
}

.health-text {
    color: white;
    font-size: 16px;
    margin-left: 8px;
}

.hotbar {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.slot {
    width: 56px;
    height: 56px;
    margin: 2px;
    background-color: rgba(20, 28, 36, 0.75);
    border-width: 2px;
    border-color: rgba(92, 113, 125, 0.6);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.slot.selected {
    border-color: rgb(165, 225, 204);
    border-width: 3px;
    background-color: rgba(34, 45, 56, 0.9);
}

.slot.filled { background-color: rgba(34, 45, 56, 0.85); }

.slot-label {
    font-size: 11px;
    color: rgb(231, 237, 241);
    -unity-text-align: middle-center;
    white-space: normal;
}

.slot-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 12px;
    color: rgb(179, 195, 205);
}

.slot-key {
    position: absolute;
    top: 1px;
    left: 3px;
    font-size: 10px;
    color: rgba(179, 195, 205, 0.5);
}

.equipped-preview {
    position: absolute;
    bottom: 20px;
    right: 20px;
    padding: 10px 14px;
    background-color: rgba(20, 28, 36, 0.75);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(92, 113, 125, 0.5);
}

.equipped-label {
    font-size: 14px;
    color: rgb(231, 237, 241);
}

.inventory-panel {
    position: absolute;
    align-self: center;
    top: 25%;
    padding: 20px;
    background-color: rgba(20, 28, 36, 0.92);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(92, 113, 125, 0.6);
}

.inventory-title {
    font-size: 20px;
    color: rgb(231, 237, 241);
    margin-bottom: 12px;
    -unity-text-align: upper-center;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 480px;
}

.drag-ghost {
    position: absolute;
    width: 50px;
    height: 50px;
    background-color: rgba(165, 225, 204, 0.4);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(165, 225, 204);
    align-items: center;
    justify-content: center;
}

.controls-hint {
    position: absolute;
    bottom: 20px;
    right: 20px;
    padding: 8px 12px;
    background-color: rgba(20, 28, 36, 0.75);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(92, 113, 125, 0.5);
}

.controls-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.controls-keycap {
    min-width: 32px;
    padding: 2px 6px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(179, 195, 205);
    border-radius: 4px;
    color: rgb(231, 237, 241);
    font-size: 12px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.controls-glyph {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
}

.controls-label {
    color: rgb(179, 195, 205);
    font-size: 13px;
}
