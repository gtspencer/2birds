:root {
    --bg-deep: rgb(12, 16, 24);
    --bg-base: rgb(20, 28, 36);
    --bg-surface: rgb(28, 38, 50);
    --bg-elevated: rgb(42, 58, 72);
    --bg-hover: rgb(54, 74, 88);
    --bg-focus: rgb(58, 80, 96);

    --border-subtle: rgba(110, 140, 165, 0.16);
    --border-default: rgba(110, 140, 165, 0.28);
    --border-accent: rgb(155, 218, 196);

    --text-primary: rgb(232, 238, 244);
    --text-secondary: rgb(168, 184, 198);
    --text-muted: rgb(118, 136, 150);

    --accent: rgb(155, 218, 196);
    --warning: rgb(255, 200, 145);
    --focus-ring: rgb(255, 238, 168);

    --health: rgb(72, 175, 88);
    --stamina: rgb(240, 195, 50);
    --reward: rgb(245, 215, 120);

    --radius-sm: 4px;
    --radius-md: 6px;
    --radius-lg: 8px;
}

.hud-root { flex-grow: 1; }

.interaction-tooltip {
    display: none;
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    border-radius: var(--radius-lg);
    background-color: rgba(12, 16, 24, 0.92);
    color: var(--text-primary);
    font-size: 16px;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.interaction-glyph {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin: 0 6px;
}

.interaction-keycap {
    min-width: 28px;
    min-height: 28px;
    margin: 0 6px;
    padding: 2px 8px;
    border-width: 1px;
    border-color: var(--text-secondary);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

.interaction-action {
    flex-shrink: 1;
    white-space: normal;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}

.charge-track {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60px;
    height: 5px;
    margin-left: -30px;
    margin-top: 14px;
    border-radius: 3px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.55);
}

.charge-fill {
    width: 0%;
    height: 100%;
    background-color: var(--accent);
    border-radius: 3px;
}

.health-container {
    position: absolute;
    bottom: 24px;
    left: 24px;
    flex-direction: row;
    align-items: center;
}

.stamina-container {
    position: absolute;
    bottom: 50px;
    left: 24px;
}

.stamina-bar-bg {
    width: 200px;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 3px;
    overflow: hidden;
}

.stamina-fill {
    height: 100%;
    width: 100%;
    background-color: var(--stamina);
    border-radius: 3px;
}

.health-bar-bg {
    width: 200px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.health-fill {
    height: 100%;
    width: 100%;
    background-color: var(--health);
    border-radius: var(--radius-sm);
}

.health-text {
    color: white;
    font-size: 15px;
    margin-left: 10px;
}

.hotbar {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.slot {
    width: 56px;
    height: 56px;
    margin: 2px;
    background-color: rgba(12, 16, 24, 0.7);
    border-width: 2px;
    border-color: rgba(110, 140, 165, 0.18);
    border-radius: var(--radius-md);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 80ms;
}

.slot.selected {
    border-color: var(--accent);
    border-width: 2px;
    background-color: rgba(28, 38, 50, 0.9);
}

.slot.filled { background-color: rgba(28, 38, 50, 0.85); }

.slot-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-label {
    display: none;
    position: absolute;
    bottom: 1px;
    left: 0;
    right: 0;
    font-size: 9px;
    color: var(--text-primary);
    -unity-text-align: lower-center;
    white-space: nowrap;
    overflow: hidden;
}

.slot-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 12px;
    color: var(--text-secondary);
}

.slot-key {
    position: absolute;
    top: 1px;
    left: 3px;
    font-size: 10px;
    color: rgba(168, 184, 198, 0.45);
    max-width: 58px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.equipped-preview {
    position: absolute;
    bottom: 24px;
    right: 24px;
    padding: 10px 14px;
    background-color: rgba(12, 16, 24, 0.7);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.equipped-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.equipped-label {
    display: none;
    font-size: 12px;
    color: var(--text-primary);
    -unity-text-align: upper-center;
    margin-top: 4px;
}

.inventory-panel {
    position: absolute;
    align-self: center;
    top: 25%;
    padding: 24px;
    background-color: rgba(12, 16, 24, 0.94);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.inventory-title {
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 14px;
    -unity-text-align: upper-center;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 480px;
}

.drag-ghost {
    position: absolute;
    width: 50px;
    height: 50px;
    background-color: rgba(155, 218, 196, 0.35);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--accent);
    align-items: center;
    justify-content: center;
}

.controls-hint {
    position: absolute;
    bottom: 24px;
    right: 24px;
    padding: 10px 14px;
    background-color: rgba(12, 16, 24, 0.7);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.controls-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.controls-keycap {
    min-width: 32px;
    padding: 2px 6px;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--text-secondary);
    border-radius: 5px;
    color: var(--text-primary);
    font-size: 12px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.controls-glyph {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
}

.controls-label {
    color: var(--text-secondary);
    font-size: 13px;
}

.bird-rewards {
    position: absolute;
    top: 24px;
    right: 28px;
    align-items: flex-end;
    color: white;
    font-size: 20px;
}

#bird-reward {
    font-size: 15px;
    color: var(--reward);
}

.slot-binding-glyph { position: absolute; top: 2px; left: 4px; width: 22px; height: 22px; }

#inventory-shortcut {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 10px;
    max-width: 480px;
    white-space: normal;
}

.inventory-grid .slot:hover { background-color: var(--bg-hover); }
.controller-navigation .inventory-grid .slot:hover { background-color: var(--bg-surface); }

.inventory-grid .slot.selected {
    border-bottom-width: 5px;
    border-bottom-color: var(--accent);
}

.inventory-grid .slot.move-source {
    background-color: rgb(95, 65, 32);
    border-left-width: 6px;
    border-left-color: rgb(245, 170, 70);
}

.inventory-grid .slot:focus, .controller-navigation .inventory-grid .slot:focus {
    background-color: var(--bg-focus);
    border-color: var(--focus-ring);
}

.inventory-grid .slot.move-source:focus { border-left-color: rgb(245, 170, 70); }
.inventory-grid .slot.selected:focus { border-bottom-color: var(--accent); }

.slot-binding { position: absolute; top: 2px; left: 4px; font-size: 12px; }

.interaction-tooltip { flex-direction: column; }
.interaction-row { flex-direction: row; align-items: center; }
.potion-buff { position: absolute; right: 24px; top: 120px; flex-direction: row; align-items: center; display: none; }
#potion-buff-icon { width: 48px; height: 48px; }
#potion-buff-time { font-size: 22px; color: white; margin-left: 8px; }
