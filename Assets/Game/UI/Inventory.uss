.inventory-hud { position: absolute; left: 24px; right: 24px; bottom: 22px; }
.inventory-health { width: 200px; }
.inventory-hotbar { position: absolute; align-self: center; bottom: 22px; flex-direction: row; }
.inventory-panel { position: absolute; align-self: center; top: 25%; width: 744px; padding: 20px; background-color: rgba(24, 35, 45, 0.97); border-radius: 10px; }
.inventory-header { flex-direction: row; justify-content: space-between; align-items: center; }
.inventory-header .title { margin-bottom: 0; }
.inventory-header Button { width: 90px; }
.inventory-row { flex-direction: row; }
.inventory-slot { width: 80px; height: 76px; margin: 4px; border-width: 2px; border-color: rgb(80, 99, 112); border-radius: 5px; background-color: rgba(38, 52, 63, 0.95); }
.inventory-slot.empty { background-color: rgba(22, 32, 42, 0.92); }
.inventory-slot.selected { border-color: rgb(173, 239, 211); }
.inventory-slot:hover, .inventory-slot:focus { background-color: rgb(57, 76, 86); }
.inventory-slot:focus { border-top-color: white; }
.inventory-slot.pending { opacity: 0.55; border-color: rgb(255, 208, 127); }
.inventory-slot.valid-target { border-color: rgb(110, 240, 150); }
.inventory-slot.invalid-target { border-color: rgb(255, 130, 110); }
.inventory-key { position: absolute; left: 4px; top: 1px; font-size: 13px; color: rgb(192, 213, 225); }
.inventory-item { position: absolute; left: 3px; right: 3px; top: 20px; font-size: 12px; white-space: normal; -unity-text-align: middle-center; }
.inventory-icon { position: absolute; left: 18px; right: 18px; top: 16px; bottom: 16px; }
.inventory-count { position: absolute; bottom: 1px; right: 4px; font-size: 13px; }
.inventory-feedback { position: absolute; align-self: center; bottom: 110px; color: rgb(255, 213, 150); background-color: rgba(20, 28, 36, 0.85); }
.inventory-tooltip { position: absolute; align-self: center; bottom: 110px; height: 22px; font-size: 14px; color: rgb(206, 235, 226); }
.inventory-ghost { position: absolute; padding: 10px; max-width: 180px; white-space: normal; background-color: rgba(50, 76, 88, 0.95); border-radius: 5px; font-size: 15px; }

.inventory-health-track { height: 12px; margin-top: 4px; background-color: rgb(25, 37, 47); border-radius: 4px; }
.inventory-health-fill { height: 12px; background-color: rgb(151, 219, 187); border-radius: 4px; }
