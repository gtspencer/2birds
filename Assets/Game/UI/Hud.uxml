<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement class="hud-root" picking-mode="Ignore">
        <ui:VisualElement class="bird-rewards" picking-mode="Ignore">
            <ui:Label name="bird-balance" text="0" picking-mode="Ignore" />
            <ui:Label name="bird-reward" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="rescue-overlay" class="rescue-overlay" picking-mode="Ignore">
            <ui:Label name="rescue-time" picking-mode="Ignore" />
            <ui:VisualElement name="give-up-prompt" picking-mode="Ignore" />
            <ui:VisualElement class="give-up-track" picking-mode="Ignore">
                <ui:VisualElement name="give-up-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="revive-overlay" class="revive-overlay" picking-mode="Ignore">
            <ui:Label text="Reviving" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="emote-overlay" class="emote-overlay" picking-mode="Ignore" />
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore" />
        <ui:VisualElement name="charge-track" class="charge-track" picking-mode="Ignore">
            <ui:VisualElement name="charge-fill" class="charge-fill" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="interaction-tooltip" class="interaction-tooltip" picking-mode="Ignore">
            <ui:VisualElement class="interaction-row" picking-mode="Ignore">
            <ui:Image name="interaction-glyph" class="interaction-glyph" picking-mode="Ignore" />
            <ui:Label name="interaction-keycap" class="interaction-keycap" picking-mode="Ignore" />
            <ui:Label name="interaction-action" class="interaction-action" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="secondary-interaction" class="interaction-row" picking-mode="Ignore">
                <ui:VisualElement name="secondary-binding" picking-mode="Ignore" />
                <ui:Label name="secondary-action" class="interaction-action" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="potion-buff" class="potion-buff" picking-mode="Ignore">
            <ui:Image name="potion-buff-icon" picking-mode="Ignore" />
            <ui:Label name="potion-buff-time" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="health-container" picking-mode="Ignore">
            <ui:VisualElement class="health-bar-bg">
                <ui:VisualElement name="health-fill" class="health-fill" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="stamina-container" picking-mode="Ignore">
            <ui:VisualElement class="stamina-bar-bg">
                <ui:VisualElement name="stamina-fill" class="stamina-fill" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="equipped-preview" class="equipped-preview" style="display:none;">
            <ui:Image name="equipped-icon" class="equipped-icon" />
            <!-- Uncomment to show equipped item name below the icon: -->
            <!-- <ui:Label name="equipped-label" class="equipped-label" /> -->
        </ui:VisualElement>
        <ui:VisualElement name="hotbar" class="hotbar" picking-mode="Ignore" />
        <ui:VisualElement name="inventory-panel" class="inventory-panel" style="display:none;">
            <ui:Label text="Inventory" class="inventory-title" />
            <ui:VisualElement name="inventory-grid" class="inventory-grid" />
        </ui:VisualElement>
        <ui:VisualElement name="controls-hint" class="controls-hint" picking-mode="Ignore" style="display:none;" />
        <ui:Label name="seat-feedback" picking-mode="Ignore" style="position: absolute; top: 58%; align-self: center; color: rgb(255, 204, 147);" />
    </ui:VisualElement>
</ui:UXML>
