<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Shared.uss" />
    <ui:Template name="Settings" src="Settings.uxml" />
    <ui:VisualElement class="screen">
        <ui:VisualElement class="card">
            <ui:Label text="TWO BIRDS" class="eyebrow" />
            <ui:Label text="A little room to move." class="title" />
            <ui:VisualElement name="main-page">
                <ui:Button name="solo" text="Solo" />
                <ui:Button name="host" text="Host" />
                <ui:Button name="join" text="Join" />
                <ui:Button name="settings" text="Settings" />
                <ui:Button name="avatar-editor-main" text="Avatar Editor" />
                <ui:Button name="quit" text="Quit" />
            </ui:VisualElement>
            <ui:VisualElement name="host-page" style="display: none;">
                <ui:Label text="Host a local session" class="heading" />
                <ui:TextField name="host-port" label="UDP port" value="7770" max-length="5" />
                <ui:Label name="host-port-error" class="field-error" />
                <ui:Label name="host-endpoint" class="hint" />
                <ui:Button name="start-host" text="Create Lobby" />
                <ui:Button name="host-back" text="Back" />
            </ui:VisualElement>
            <ui:VisualElement name="join-page" style="display: none;">
                <ui:Label text="Join a session" class="heading" />
                <ui:VisualElement name="local-join">
                    <ui:TextField name="join-ip" label="Host IP" value="127.0.0.1" max-length="15" />
                <ui:Label name="join-ip-error" class="field-error" />
                    <ui:TextField name="join-port" label="UDP port" value="7770" max-length="5" />
                <ui:Label name="join-port-error" class="field-error" />
                    <ui:Button name="connect" text="Connect" />
                </ui:VisualElement>
                <ui:VisualElement name="steam-join">
                    <ui:Label name="friends-status" class="hint" />
                    <ui:ScrollView name="friends-list" style="max-height: 250px;" />
                    <ui:Button name="friends-refresh" text="Refresh Friends' Lobbies" />
                </ui:VisualElement>
                <ui:Button name="join-back" text="Back" />
            </ui:VisualElement>
            <ui:VisualElement name="lobby-page" style="display: none;">
                <ui:Label text="Session lobby" class="heading" />
                <ui:Label name="lobby-endpoint" class="hint" />
                <ui:VisualElement name="roster" />
                <ui:Button name="start-game" text="Start Game" />
                <ui:Button name="invite" text="Invite Steam Friends" />
                <ui:Button name="avatar-editor-lobby" text="Avatar Editor" />
                <ui:Button name="lobby-leave" text="Leave Lobby" />
            </ui:VisualElement>
            <ui:Instance template="Settings" class="shared-settings" />
            <ui:VisualElement name="endpoint-entry" style="display: none;">
                <ui:Label text="Edit endpoint" class="heading" />
                <ui:TextField name="entry-value" />
                <ui:Label name="entry-error" class="field-error" />
                <ui:VisualElement name="entry-keys" class="entry-keys" />
                <ui:Button name="entry-confirm" text="Confirm" />
                <ui:Button name="entry-cancel" text="Cancel" />
            </ui:VisualElement>
            <ui:VisualElement name="menu-footer" class="hint" />
            <ui:Label name="status" class="status" />
            <ui:Button name="cancel" text="Cancel connection" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
